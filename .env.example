# Copy to .env for local development and fill in real values.
#
# .env is gitignored. NEVER commit real credentials -- this file exists so the
# NAMES are documented while the values stay out of version control.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

API_BASE_URL=http://localhost:8080
APP_BASE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Database
#
# Three roles, three connection strings. The separation is what stops a bug in
# request handling from reaching another customer's data -- see db/migrations/
# 0008_rls.sql.
#
#   DATABASE_URL           ocs_app      request handling; always one tenant
#   DATABASE_SERVICE_URL   ocs_service  background jobs; may cross tenants
#   DATABASE_MIGRATION_URL postgres     owner; schema changes only
#
# On Supabase use the SESSION pooler (port 5432). The transaction pooler breaks
# tenant isolation, because SET LOCAL and the statements that depend on it can
# land on different backend connections.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://ocs_app:PASSWORD@localhost:5432/ocs
DATABASE_SERVICE_URL=postgresql://ocs_service:PASSWORD@localhost:5432/ocs
DATABASE_MIGRATION_URL=postgresql://postgres:PASSWORD@localhost:5432/ocs
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Supabase (authentication + file storage)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Secret. Signs storage URLs and bypasses storage policies. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=
# Only needed for legacy HS256 projects. Leave blank when using JWKS keys.
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=ocs-documents

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
# From the Stripe dashboard's webhook endpoint. Without it, webhook signatures
# cannot be verified and the endpoint refuses to process anything.
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Email (optional)
#
# Unset means in-app notifications still work and delivery rows are recorded as
# failed with a reason -- never silently dropped, never falsely marked sent.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Exact origins, comma-separated. "*" is rejected in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Encrypts municipal portal credentials at rest. Generate with:
#   openssl rand -base64 32
# Losing this makes stored portal credentials unrecoverable.
INTEGRATION_ENCRYPTION_KEY=
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
MAX_UPLOAD_BYTES=104857600
DOCUMENT_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
WORKER_ENABLED=true
WORKER_CONCURRENCY=4

# ---------------------------------------------------------------------------
# Tests only (see README "Running the tests")
# ---------------------------------------------------------------------------
TEST_DATABASE_URL=
TEST_APP_DATABASE_URL=
TEST_SERVICE_DATABASE_URL=
